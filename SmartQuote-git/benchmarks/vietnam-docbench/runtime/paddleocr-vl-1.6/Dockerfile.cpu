FROM node:20.19.5-bookworm-slim AS node_runtime
FROM python:3.12-slim-bookworm

ARG PADDLEPADDLE_VERSION=3.2.1
ARG PADDLEOCR_VERSION=3.7.0

COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PADDLE_PDX_CACHE_HOME=/model-cache \
    SQ_PADDLEOCR_VL_PIPELINE_VERSION=v1.6 \
    SQ_PADDLEOCR_VL_BACKEND=native \
    SQ_PADDLEOCR_VL_DEVICE=cpu

RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl libglib2.0-0 libgl1 libgomp1 libstdc++6 libatomic1 \
    && python -m pip install --upgrade pip setuptools wheel \
    && rm -rf /var/lib/apt/lists/*

RUN python -m pip install "paddlepaddle==${PADDLEPADDLE_VERSION}" -i https://www.paddlepaddle.org.cn/packages/stable/cpu/ \
    && python -m pip install "paddleocr[doc-parser]==${PADDLEOCR_VERSION}"

RUN mkdir -p /opt/smartquote-runtime && python -m pip freeze > /opt/smartquote-runtime/pip-freeze.txt

WORKDIR /workspace
RUN mkdir -p /model-cache /private
CMD ["python", "--version"]
