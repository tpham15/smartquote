# Consistent line endings and robust binary handling
* text=auto
*.sh text eol=lf
*.command text eol=lf
*.sql text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.mjs text eol=lf
*.md text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.pdf binary
*.xlsx binary
*.xls binary
*.zip binary
