# SmartQuote environment example
# Copy to .env.local for local development. Never commit real secrets.

# Frontend Supabase values (public browser configuration)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase values. NEVER prefix the service key with VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Server-only AI/search providers
ANTHROPIC_API_KEY=
SERPER_API_KEY=
SMARTQUOTE_SERPER_API_KEY=

# Payment display configuration (public UI values, not banking credentials for API access)
VITE_SQ_PAYMENT_BANK_ID=
VITE_SQ_PAYMENT_BANK=
VITE_SQ_PAYMENT_ACCOUNT=
VITE_SQ_PAYMENT_OWNER=
VITE_SQ_PAYMENT_QR_TEMPLATE=compact2
VITE_SQ_SUPPORT_CONTACT=

# Upload guards
VITE_SQ_MAX_EXCEL_BYTES=15728640
VITE_SQ_MAX_PDF_BYTES=20971520
VITE_SQ_MAX_IMAGE_BYTES=10485760
VITE_SQ_MAX_IMPORT_FILES=10

# CORS is CLOSED to cross-origin requests by default.
# Leave these empty to allow same-origin only. Never set production origin to '*'.
SMARTQUOTE_ALLOWED_ORIGIN=
SMARTQUOTE_ALLOWED_ORIGINS=

# Production guardrails. Keep disabled flags false/empty in production.
SMARTQUOTE_API_AUTH_DISABLED=false
SMARTQUOTE_RATE_LIMIT_DISABLED=false
SMARTQUOTE_EXTERNAL_BUDGET_DISABLED=false
SMARTQUOTE_IMG_RATE_LIMIT_PER_MIN=60

# Optional provider/body limits
SMARTQUOTE_MAX_CLAUDE_BODY_BYTES=
SMARTQUOTE_MAX_CLAUDE_DOCUMENT_BASE64_CHARS=
SMARTQUOTE_MAX_CLAUDE_IMAGE_BASE64_CHARS=
SMARTQUOTE_MAX_CLAUDE_MESSAGES=
SMARTQUOTE_MAX_CLAUDE_OUTPUT_TOKENS=
SMARTQUOTE_MAX_CLAUDE_SYSTEM_CHARS=
SMARTQUOTE_MAX_CLAUDE_TEXT_CHARS=
SMARTQUOTE_MAX_PDF_BODY_BYTES=
SMARTQUOTE_MAX_PRODUCT_ENRICH_BODY_BYTES=
SMARTQUOTE_MAX_WEB_SCRAPE_BODY_BYTES=
SMARTQUOTE_ALLOWED_CLAUDE_MODELS=
SMARTQUOTE_EXTERNAL_API_UNIT_COST_USD=

# Optional private regression corpus path (never commit customer files)
SQ_DOCBENCH_PRIVATE_MANIFEST=
