# Supabase frontend keys
# Project Settings -> API
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY

# Supabase server-only keys for /api/* auth. Put these in Vercel env only.
# Never expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Existing API keys if you use Claude/PDF features
ANTHROPIC_API_KEY=YOUR_ANTHROPIC_API_KEY

# Optional local-only bypass for serverless API auth.
# Do not set this in production.
# SMARTQUOTE_API_AUTH_DISABLED=true

# Optional CORS lock in production, e.g. https://app.smartquote.vn
# SMARTQUOTE_ALLOWED_ORIGIN=*

# Phase 6 manual payment copy shown on Upgrade page
VITE_SQ_SUPPORT_CONTACT=Zalo/Hotline: 090x xxx xxx
VITE_SQ_PAYMENT_BANK=Ngân hàng: MB Bank / Vietcombank / ...
VITE_SQ_PAYMENT_ACCOUNT=0123456789
VITE_SQ_PAYMENT_OWNER=SMARTQUOTE VIET NAM

# Phase 7 production hardening
# In production set this to your exact app origin(s), comma-separated.
# Example: SMARTQUOTE_ALLOWED_ORIGIN=https://app.smartquote.vn,https://smartquote.vn
SMARTQUOTE_ALLOWED_ORIGIN=*

# Optional API body/rate guardrails. Defaults are safe for beta.
SMARTQUOTE_MAX_CLAUDE_BODY_BYTES=1200000
SMARTQUOTE_MAX_WEB_SCRAPE_BODY_BYTES=100000
SMARTQUOTE_MAX_PDF_BODY_BYTES=20000000
SMARTQUOTE_MAX_EXCEL_BODY_BYTES=2500000
SMARTQUOTE_IMG_RATE_LIMIT_PER_MIN=180
# SMARTQUOTE_RATE_LIMIT_DISABLED=true

# Phase 8 Product Enrichment search provider.
# Recommended: set this on Vercel server env so users do not need to paste their own key.
SERPER_API_KEY=YOUR_SERPER_API_KEY
SMARTQUOTE_MAX_PRODUCT_ENRICH_BODY_BYTES=200000

# Phase 8.2 external API cost tracking / budget guardrails.
# Defaults also live in supabase/phase8_2_operational_guardrails.sql.
# Override only when your real Serper plan/cost changes.
# SMARTQUOTE_SERPER_UNIT_COST_USD=0.001
# SMARTQUOTE_SERPER_MONTHLY_BUDGET_USD=3
# SMARTQUOTE_SERPER_STARTER_MONTHLY_BUDGET_USD=0.75
# SMARTQUOTE_SERPER_PRO_MONTHLY_BUDGET_USD=3
# SMARTQUOTE_SERPER_BUSINESS_MONTHLY_BUDGET_USD=12
# SMARTQUOTE_EXTERNAL_BUDGET_DISABLED=true  # local/dev only, never production
